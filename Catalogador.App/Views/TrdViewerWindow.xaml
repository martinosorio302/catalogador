<Window x:Class="CatalogadorEsSalud.Views.TrdViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Visor TRD - Tabla de Retención Documental EsSalud" 
        Height="700" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    
    <Window.Resources>
        <!-- Estilo para botones -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4472C4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#365BA8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Convertidor de booleano a visibilidad -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4472C4" Padding="20,15" CornerRadius="8" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="TABLA DE RETENCIÓN DOCUMENTAL - ESSALUD" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="Total series: " 
                                   Foreground="White" 
                                   FontSize="14"/>
                        <TextBlock Text="{Binding TotalSeries}" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="14"/>
                        <TextBlock Text=" | Versión: " 
                                   Foreground="White" 
                                   FontSize="14" 
                                   Margin="15,0,0,0"/>
                        <TextBlock Text="{Binding VersionTrd}" 
                                   Foreground="White" 
                                   FontWeight="Bold" 
                                   FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" 
                        Content="↻ Recargar" 
                        Style="{StaticResource ModernButton}"
                        Command="{Binding RecargarCommand}"
                        Background="#5B9BD5"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Filtros -->
        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,10" 
                BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Buscar por código o título:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="txtBuscar"
                             Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8"
                             FontSize="14"
                             BorderBrush="#CCCCCC"
                             BorderThickness="1"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="15,0,0,0">
                    <TextBlock Text="Filtrar por valor:" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding OpcionesFiltroValor}"
                              SelectedItem="{Binding FiltroValor}"
                              Padding="8"
                              FontSize="14"
                              BorderBrush="#CCCCCC"
                              BorderThickness="1"/>
                </StackPanel>

                <Button Grid.Column="2" 
                        Content="🔍 Buscar" 
                        Style="{StaticResource ModernButton}"
                        Command="{Binding BuscarCommand}"
                        Margin="15,23,0,0"
                        Width="120"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <!-- Loading Overlay -->
                <Border Background="#80FFFFFF" 
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                        Panel.ZIndex="100">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏳ Cargando series TRD..." 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#4472C4"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Por favor espere..." 
                                   FontSize="14" 
                                   Foreground="#666666"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="dgSeries"
                          ItemsSource="{Binding SeriesPaginadas}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F9F9F9"
                          BorderThickness="0">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" 
                                          Binding="{Binding Codigo}" 
                                          Width="100"
                                          FontWeight="SemiBold"/>
                        
                        <DataGridTextColumn Header="Título Serie" 
                                          Binding="{Binding TituloSerie}" 
                                          Width="*"
                                          MinWidth="250"/>
                        
                        <DataGridTextColumn Header="AG" 
                                          Binding="{Binding PlazoAG}" 
                                          Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="AP" 
                                          Binding="{Binding PlazoAP}" 
                                          Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="AC" 
                                          Binding="{Binding PlazoOAA}" 
                                          Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="Total" 
                                          Binding="{Binding Temporalidad}" 
                                          Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="Destino" 
                                          Binding="{Binding Destino}" 
                                          Width="200"/>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EsPermanente}" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Paginación -->
        <Border Grid.Row="3" Background="White" Padding="15" CornerRadius="8" Margin="0,10,0,10"
                BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botones navegación -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="⏮ Primera" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding IrPrimeraPaginaCommand}"
                            Margin="0,0,5,0"
                            Width="100"/>
                    <Button Content="◀ Anterior" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding PaginaAnteriorCommand}"
                            Margin="5,0"
                            Width="100"/>
                    <Button Content="Siguiente ▶" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding PaginaSiguienteCommand}"
                            Margin="5,0"
                            Width="110"/>
                    <Button Content="Última ⏭" 
                            Style="{StaticResource ModernButton}"
                            Command="{Binding IrUltimaPaginaCommand}"
                            Margin="5,0,0,0"
                            Width="100"/>
                </StackPanel>

                <!-- Info paginación -->
                <TextBlock Grid.Column="1" 
                           Text="{Binding TextoPaginacion}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#666666"/>

                <!-- Botón exportar -->
                <Button Grid.Column="2" 
                        Content="📊 Exportar a Excel" 
                        Style="{StaticResource ModernButton}"
                        Command="{Binding ExportarCommand}"
                        Background="#28A745"
                        Width="160"/>
            </Grid>
        </Border>

        <!-- Footer con leyenda -->
        <Border Grid.Row="4" Background="#F0F0F0" Padding="15" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Rectangle Width="20" Height="20" Fill="#E8F5E9" Margin="0,0,10,0"/>
                <TextBlock Text="= Conservación Permanente" 
                           VerticalAlignment="Center" 
                           Margin="0,0,30,0"
                           Foreground="#2E7D32"
                           FontWeight="SemiBold"/>
                
                <Rectangle Width="20" Height="20" Fill="White" Stroke="#CCCCCC" StrokeThickness="1" Margin="0,0,10,0"/>
                <TextBlock Text="= Temporal (Eliminación programada)" 
                           VerticalAlignment="Center"
                           Foreground="#666666"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Overlay de exportación -->
        <Border Grid.RowSpan="5" 
                Background="#80000000" 
                Visibility="{Binding IsExporting, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="200">
            <Border Background="White" 
                    Padding="40" 
                    CornerRadius="10" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="📊 Exportando a Excel..." 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#28A745"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Por favor espere..." 
                               FontSize="14" 
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
