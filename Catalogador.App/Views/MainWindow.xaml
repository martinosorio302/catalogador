<Window x:Class="CatalogadorEsSalud.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Catalogador EsSalud - Gestión Documental" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0066CC" Padding="15">
            <StackPanel>
                <TextBlock Text="Catalogador EsSalud" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="Sistema de Catalogación y Clasificación Documental" 
                           FontSize="12" 
                           Foreground="White" 
                           Opacity="0.8"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10">
            
            <!-- Upload Tab -->
            <TabItem Header="Carga de Documentos">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="btnSelectFile" 
                                Content="Seleccionar Archivo" 
                                Width="150" 
                                Height="35" 
                                Margin="0,0,10,0"
                                Click="BtnSelectFile_Click"/>
                        <Button x:Name="btnUpload" 
                                Content="Procesar Documento" 
                                Width="150" 
                                Height="35"
                                IsEnabled="False"
                                Click="BtnUpload_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" 
                               x:Name="txtSelectedFile" 
                               Text="Ningún archivo seleccionado" 
                               Margin="0,0,0,10"
                               Foreground="Gray"/>

                    <Border Grid.Row="2" 
                            BorderBrush="LightGray" 
                            BorderThickness="1" 
                            CornerRadius="5">
                        <ScrollViewer>
                            <TextBlock x:Name="txtResults" 
                                       Text="Resultados del procesamiento aparecerán aquí..." 
                                       Padding="10"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Classification Tab -->
            <TabItem Header="Clasificación TRD">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Tabla de Retención Documental (TRD)" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnLoadTrd" 
                                    Content="Cargar TRD" 
                                    Width="120" 
                                    Height="30"
                                    Margin="0,0,10,0"
                                    Click="BtnLoadTrd_Click"/>
                            <Button x:Name="btnVerTrdCompleto" 
                                    Content="📋 Ver TRD Completo (541 Series)" 
                                    Width="250" 
                                    Height="30"
                                    Background="#4472C4"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Click="BtnVerTrdCompleto_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" 
                            BorderBrush="LightGray" 
                            BorderThickness="1" 
                            CornerRadius="5">
                        <ScrollViewer>
                            <TextBlock x:Name="txtTrdInfo" 
                                       Text="Información TRD aparecerá aquí..." 
                                       Padding="10"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Export Tab -->
            <TabItem Header="Exportar Inventario">
                <Grid Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Exportar Inventario Documental" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,20"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="btnExport" 
                                Content="Exportar a Excel" 
                                Width="200" 
                                Height="40"
                                FontSize="14"
                                Click="BtnExport_Click"/>
                        <TextBlock x:Name="txtExportStatus" 
                                   Text="" 
                                   Margin="0,15,0,0"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                BorderBrush="LightGray" 
                BorderThickness="0,1,0,0" 
                Padding="10,5">
            <Grid>
                <TextBlock x:Name="txtStatus" 
                           Text="Listo" 
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Ellipse x:Name="statusIndicator" 
                             Width="10" 
                             Height="10" 
                             Fill="Gray" 
                             Margin="0,0,5,0"/>
                    <TextBlock x:Name="txtApiStatus" 
                               Text="API: Verificando..." 
                               VerticalAlignment="Center"
                               FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
