{
  "compilerOptions": {
    "target": "ES2020",
  "module": "NodeNext",
  "moduleResolution": "nodenext",
  "allowSyntheticDefaultImports": true,
    "outDir": "dist-esm",
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/index.ts",
    "src/data/**/*",
    "src/domain/**/*"
  ]
}
