[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://<YOUR_USER>@github.com/martinosorio302/catalogador.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[lfs]
	repositoryformatversion = 0
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[lfs "https://github.com/martinosorio302/catalogador.git/info/lfs"]
	access = basic
[branch "orcid.org/0000-0002-9629-487X"]
	remote = origin
	merge = refs/heads/orcid.org/0000-0002-9629-487X
[branch "fix/auto-redeploy-and-hyperprompt"]
	remote = origin
	vscode-merge-base = origin/fix/auto-redeploy-and-hyperprompt
	merge = refs/heads/fix/auto-redeploy-and-hyperprompt
[branch "fix/mi-cambio-descripcion"]
	vscode-merge-base = origin/fix/auto-redeploy-and-hyperprompt
