{
  "name": "catalogador-essalud",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "description": "Catalogador EsSalud - escritorio para ingestión, OCR, clasificación y TRD/Inventario",
  "author": "EsSalud Catalogador Team",
  "repository": { "type": "git", "url": "https://example.com/your-repo/catalogador.git" },
  "scripts": {
    "start:web": "cd src && npm run dev",
    "build:web": "cd src && npm run build",
    "build:web:copy": "powershell -NoProfile -ExecutionPolicy Bypass -File tools\\build_and_copy.ps1",
    "electron:dev": "concurrently \"cd src && npm run dev\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "electron:build": "npm run build:web:copy && electron-builder --win --x64 --publish never",
    "electron:build:dir": "npm run build:web:copy && electron-builder --win --x64 --dir --config.directories.output=dist-electron"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "vite": "^5.4.10",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "concurrently": "^8.2.2",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.essalud.catalogador",
    "productName": "Catalogador EsSalud",
    "directories": { "output": "dist-electron" },
    "files": ["dist/**", "electron/**"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "publish": []
  }
}